# BukaKios WebView Simple - Environment Variables
# Copy ke .env dan isi nilainya

APP_URL=http://localhost:8080
TEMPLATE_DIR=_template
TEMPLATE_URL=

# API Key (dari BukaKios API)
API_KEY=your_api_key_here

# API Base URL
API_URL=

# API v2
API_V2_KEY=
API_V2_SECRET=
API_V2_URL=
API_V2_WV_URL=

# WhatsApp
WA_NUMBER=6282184284119

# Warna tema
PRIMARY=#E53935
SECONDARY=#F57C00

# FCM (opsional)
FCM_KEY=your_fcm_key_here

# OPEN URL untuk open.php
OPEN_URL=https://wv.bukakios.net/
