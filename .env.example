# BukaKios WebView Simple — contoh environment
# Copy jadi .env lalu isi nilai asli. File .env tidak di-commit (gitignored).

# ── App ──────────────────────────────────────────────────────────────────────
APP_URL=https://wv-simple.bukakios.net

# ── API v1 ───────────────────────────────────────────────────────────────────
API_KEY=
API_URL=https://api.bukakios.net

# ── API v2 (lib/ApiV2.php) ──────────────────────────────────────────────────
API_V2_URL=https://api-v2.bukakios.net/v2
API_V2_WV_URL=https://api-v2.bukakios.net/wv-x7Up2p
API_V2_SECRET=
API_V2_KEY=

# ── WhatsApp CS ─────────────────────────────────────────────────────────────
# Semua link WA di page dibangun via wa_link() di config.php dari nilai ini.
# JANGAN hardcode link WA di file page.
WA_NUMBER=6282184284119
WA_BASE_URL=https://api.whatsapp.com/send
WA_DEFAULT_TEXT=Halo kak, saya butuh bantuan di Bukakios

# ── Webview scheme (link open:// untuk app) ─────────────────────────────────
OPEN_URL_SCHEME=open://

# ── Theme ───────────────────────────────────────────────────────────────────
PRIMARY_COLOR=#E53935
SECONDARY_COLOR=#1976D2

# ── Firebase Cloud Messaging ────────────────────────────────────────────────
FCM_KEY=
